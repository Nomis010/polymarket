{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "nodeVersion": "20.x",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "env": {
    "SESSION_SECRET": "@session_secret",
    "ADMIN_PASSWORD": "@admin_password",
    "ADMIN_USERNAME": "@admin_username",
    "STARTING_BALANCE": "@starting_balance"
  }
}
