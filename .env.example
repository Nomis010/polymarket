# Variables d'environnement requises pour Vercel

# Secret pour signer les sessions JWT
SESSION_SECRET=votre_secret_long_et_aleatoire_ici

# Mot de passe administrateur
ADMIN_PASSWORD=votre_mot_de_passe_admin_change_moi

# Optionnel: Nom d'utilisateur administrateur
ADMIN_USERNAME=admin

# Optionnel: Solde de départ des utilisateurs
STARTING_BALANCE=1000

# Variables Vercel KV (générées automatiquement par Vercel)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
